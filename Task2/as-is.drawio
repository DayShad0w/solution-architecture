<mxfile host="app.diagrams.net" type="device">
  <diagram id="AS-IS" name="AS-IS">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="leg" value="AS-IS по коду createOrder и интервью. Красное — горячий путь и обходы. Жёлтое — Oracle, система записи и интеграционный слой. Пунктир — зависимость, которую назвали, но в коде и на учебной схеме её нет." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=8;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1480" height="50" as="geometry"/></mxCell>
<mxCell id="client" value="Клиент" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="120" height="60" as="geometry"/></mxCell>
<mxCell id="web" value="Сайт и мобильное&#10;приложение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="220" y="90" width="190" height="50" as="geometry"/></mxCell>
