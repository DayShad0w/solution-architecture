<mxCell id="biz" value="Маркетинг,&#10;финансы, операции" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="500" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="mono" value="Java-монолит, один процесс-оркестратор" style="swimlane;html=1;startSize=28;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=13;rounded=1;arcSize=6;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460" y="90" width="380" height="200" as="geometry"/></mxCell>
<mxCell id="create" value="createOrder&#10;цена в коде, промо-сервис или legacy_promo_pkg,&#10;запись заказа, INT_ORDER_EXPORT,&#10;правило маршрута, резерв доставки,&#10;платёжная сессия, сырой статус" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="mono"><mxGeometry x="16" y="40" width="348" height="140" as="geometry"/></mxCell>
<mxCell id="admin" value="Админка&#10;правка технического статуса" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="460" y="320" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="ora" value="Oracle&#10;ORDERS, legacy_promo_pkg,&#10;INT_ORDER_EXPORT,&#10;RETRY_DELIVERY_QUEUE,&#10;правила маршрута, история статусов" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="250" height="210" as="geometry"/></mxCell>
<mxCell id="net" value=".NET&#10;читает INT_ORDER_EXPORT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="900" y="350" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="py" value="Python jobs и BI&#10;тяжёлые выборки&#10;из операционной Oracle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1180" y="180" width="230" height="90" as="geometry"/></mxCell>
