<mxCell id="promo" value="Промо-сервис&#10;на учебной схеме его нет" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="430" width="200" height="80" as="geometry"/></mxCell>
