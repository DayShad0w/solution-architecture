<mxfile host="app.diagrams.net" type="device">
  <diagram id="TO-BE" name="TO-BE">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="leg" value="TO-BE первого этапа. Зелёное — журнал и история. Серое — горячий путь, его не меняем. Жёлтое — Oracle остаётся системой записи. Фасад партнёра и пилот показателя на схему не вынесены." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=8;arcSize=4;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1500" height="44" as="geometry"/></mxCell>
<mxCell id="client" value="Клиент" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="110" height="56" as="geometry"/></mxCell>
<mxCell id="web" value="Сайт, приложение,&#10;маркетплейсы&#10;контракт прежний" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="180" height="80" as="geometry"/></mxCell>
<mxCell id="support" value="Оператор&#10;поддержки" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="120" height="70" as="geometry"/></mxCell>
<mxCell id="mono" value="Java-монолит, система записи заказа" style="swimlane;html=1;startSize=28;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=13;rounded=1;arcSize=6;collapsible=0;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="430" height="200" as="geometry"/></mxCell>
<mxCell id="create" value="createOrder&#10;цена, промо, маршрут,&#10;резерв, оплата, сырой статус&#10;без новых внешних вызовов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="mono"><mxGeometry x="16" y="40" width="250" height="140" as="geometry"/></mxCell>
<mxCell id="fact" value="Узкий факт&#10;или хвост&#10;существующей&#10;истории" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="mono"><mxGeometry x="286" y="48" width="124" height="124" as="geometry"/></mxCell>
<mxCell id="ora" value="Oracle&#10;строка заказа, пакет промо,&#10;правила маршрута,&#10;staging как сейчас" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="230" height="170" as="geometry"/></mxCell>
<mxCell id="journal" value="Журнал фактов&#10;не брокер и&#10;не система записи" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="90" width="180" height="120" as="geometry"/></mxCell>
<mxCell id="timeline" value="История для поддержки&#10;своё хранилище,&#10;собирается из журнала" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="admin" value="Админка&#10;прежняя правка.&#10;Известные точки пишут факт" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="old" value=".NET и доставка&#10;в этот этап не входят" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="880" y="310" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="reports" value="Отчёты&#10;по-прежнему из Oracle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1160" y="250" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="promo" value="Промо-сервис&#10;и пакет Oracle" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="230" width="160" height="70" as="geometry"/></mxCell>
<mxCell id="pay" value="Платёжные&#10;провайдеры" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="330" width="150" height="70" as="geometry"/></mxCell>
<mxCell id="del" value="Службы доставки&#10;прежние способы" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="430" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="note" value="Экран клиента не переключается, пока нет справочника статусов.&#10;Факт пути промо пишется тем же флагом вставки. Если вставку запретят, история читает хвост статусов, а факт промо не появляется.&#10;При расхождении со строкой заказа права Oracle." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="780" height="80" as="geometry"/></mxCell>
<mxCell id="note2" value="Фасад партнёра и витрина одного показателя — следующие точки.&#10;Их нет на этой схеме: без журнала их нечем проверить." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="840" y="540" width="500" height="70" as="geometry"/></mxCell>
